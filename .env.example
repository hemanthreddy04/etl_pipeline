# Copy to .env for local runs:  set -a; . ./.env; set +a
APP_TOKEN=change-me                 # every API and MCP call must send this. Leave empty only on your own machine.
STATE_URI=./data/state.json         # or gs://your-bucket/state.json on Cloud Run
ENVIRONMENT=dev
SCHEMA_PREFIX=                      # e.g. mcp_ gives mcp_bronze, mcp_silver, mcp_gold
GCP_PROJECT=                        # default project for BigQuery and Secret Manager
# DATABRICKS_TOKEN=                 # or keep it in Secret Manager and name the secret on the connection
# ALERT_WEBHOOK_URL=                # chat alerts (Slack or Teams incoming webhook)
# PAGER_WEBHOOK_URL=
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM= ALERT_EMAIL_TO=
# ANTHROPIC_API_KEY=                # switches the built-in agent on
# AGENT_MODEL=claude-sonnet-5-5
